! ### Concrete ###
! Concrete linear
MP,EX,1,e_c			
MP,PRXY,1,nu_c	

*IF,switch_model,eq,0,then
	! Concrete DP without/with HSD
	MAT,1
	TB,CONCR,1,,,DP								! Drucker-Prager concrete strength parameters			
	TBDATA,1,R_c,R_t,R_b

	*IF,switch_hsd,eq,1,then	
		TB,CONCR,1,,,DILA						! Drucker-Prager concrete dilatation	
		TBDATA,1,del_t,del_c

	! HSD laws
		*IF,switch_dp,eq,0,then
			TB,CONCR,1,,,HSD2
			TBDATA,1,kappa_cm,kappa_cu,omega_ci,omega_cu,omega_cr,G_ft
			TBDATA,7,omega_tr
		*ELSEIF,switch_dp,eq,1,then
			TB,CONCR,1,,,HSD6
			TBDATA,1,kappa_cm,kappa_cr,omega_ci,omega_cr,kappa_tr,omega_tr
		*ENDIF		
	*ENDIF
*ELSEIF,switch_model,eq,1,then
	! Concrete with Microplane approach
	MAT,1
	TB,MPLA,1,,,DPC
	TBDATA,1,R_c,R_b,R_t,Rt,D_MP,sigVc0
	TBDATA,7,R_MP,gamt0,gamc0,betat,betac
	
	TB,MPLA,1,,,NLOCAL
	TBDATA,1,c_MP,m_MP
*ELSE
	*MSG,'Unkwon model selected'
	/EOF
*ENDIF

! ### Reinforcement ###						
! Steel linear
MP,EX,2,e_reinf		
MP,PRXY,2,nu_reinf

! Steel nonlinear
MAT,2
TB,MISO,2,1,2
TBPT,DEFI,eps_ry,sig_ry
TBPT,DEFI,eps_ru,sig_ru
	!/axlab,X,Strain (/)				! For display
	!/axlab,Y,Stress (N/m^2)
	!TBPLOT,MISO,2

! ### Support and load plates ###
! Steel linear
MP,EX,3,e_supp	
MP,PRXY,3,nu_supp
