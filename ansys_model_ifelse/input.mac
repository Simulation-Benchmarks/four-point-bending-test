/CLEAR
FINISH

! Set filenames
filname = 'REINF_CONC_BEAM'
/FILNAME, filname
/OUTPUT,output,txt

! Model selection - generated by Snakemake (see Snakefile rule run_ansys)
! Must load before parameters_material.txt, which branches on switch_model.
/INPUT,../../model_select,mac

! Read input parameters from file
PI = acos(-1)
/INPUT,../../parameters,txt
/INPUT,../../parameters_material,txt

! Start pre-processing
! /INPUT,prep,mac
/INPUT,../../prep,mac

! Start solution
/INPUT,../../solution,mac

! Start post-processing
/INPUT,../../post,mac


