/CLEAR
FINISH

! Set filenames
filname = 'REINF_CONC_BEAM'
/FILNAME, filname
/OUTPUT,output,txt

! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
! Rendered by Snakemake (rule render_input) from common/input.mac.j2,
! common/parameters.json and drucker_prager/parameters.json. Do not edit by hand.
! ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

! Model selection - prep.mac and material.mac substitute %MAT_MODEL% into a subdirectory name
MAT_MODEL = 'drucker_prager'

PI = acos(-1)

! ### Input parameters (from JSON) ###
! --- geometry ---
length_span = 4
length_cant = 0.255
length_load = 1
height_tot = 0.625
depth_tot = 0.30
height_cover = 0.0385
width_cover = 0.0385
width_supp = 0.3
width_load = 0.2
height_load = 0.05
height_supp = 0.05
x_stirrup_1 = 0.06
x_stirrup_2 = 0.165
x_stirrup_3 = 0.12
num_cuts_12cm = 10
! --- mesh ---
ele_length = 0.05
! --- reinforcement ---
diam_reinf_lower = 26e-3
diam_reinf_upper = 10e-3
diam_reinf_stir = 10e-3
! --- loading ---
displacement = -0.007
! --- solver ---
step_init = 200
step_max = 20000
step_min = 25
! --- reinforcement_steel ---
e_reinf = 2.05e11
nu_reinf = 0.3
sig_ry = 401.00e6
sig_ru = 596.00e6
eps_ru = 0.231
! --- plate_steel ---
e_supp = 2.1e11
nu_supp = 0.3
! --- concrete ---
e_c = 25660e6
nu_c = 0.2
sig_cc = 16.71e6
sig_ct = 1.30e6
! --- dilatation ---
del_t = 0.25
del_c = 1.0
! --- hsd ---
omega_ci = 0.33
omega_cr = 0.2
omega_tr = 0.1
kappa_cr = 0.01
kappa_tr = 0.001
omega_cu = 0.85
G_ft = 100
! --- switches ---
switch_hsd = 1
switch_dp = 0

! ### Derived parameters ###
eps_ry = sig_ry/e_reinf		! reinforcement yield strain [-]
! DP strength parameters (also consumed by the Microplane TBDATA call)
R_c	= sig_cc				! Uniaxial compressive strength
R_t	= sig_ct				! Uniaxial tensile strength (recommended by dynardo (multiplas): R_t=0.1*R_c for normal concrete)
R_b	= 1.2*R_c				! Biaxial compressive strength (recommended by dynardo (multiplas): R_b=1.2*R_c for normal concrete)

! Start pre-processing
/INPUT,../../common/prep,mac

! Start solution
/INPUT,../../common/solution,mac

! Start post-processing
/INPUT,../../common/post,mac
