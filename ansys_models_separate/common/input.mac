/CLEAR
FINISH

! Set filenames
filname = 'REINF_CONC_BEAM'
/FILNAME, filname
/OUTPUT,output,txt

! Model selection - generated by Snakemake (see Snakefile rule run_ansys)
! Must load before ../%MAT_MODEL%/parameters_material and prep.mac, which
! both substitute %MAT_MODEL% into a subdirectory name.
/INPUT,../../common/model_select,mac

! Read input parameters from file
PI = acos(-1)
/INPUT,../../common/parameters,txt
/INPUT,../../common/parameters_material,txt
/INPUT,../../%MAT_MODEL%/parameters_material,txt

! Start pre-processing
/INPUT,../../common/prep,mac

! Start solution
/INPUT,../../common/solution,mac

! Start post-processing
/INPUT,../../common/post,mac


