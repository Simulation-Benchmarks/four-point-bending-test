import subprocess
from pathlib import Path

ANSYS_EXE = "C:/Program Files/ANSYS Inc/v231/ansys/bin/winx64/ANSYS231.exe"
JOBNAME = "REINF_CONC_BEAM"

configfile: "config.yaml"

_VALID_MODELS = ("drucker_prager", "microplane")
MODEL = config.get("model")
if MODEL not in _VALID_MODELS:
    raise ValueError(f"config['model'] must be one of {_VALID_MODELS}, got {MODEL!r}")

ANSYS_MODELS_DIR = Path(workflow.basedir)
RESULTS_DIR = ANSYS_MODELS_DIR / "results" / MODEL

rule all:
    input:
        f"results/{MODEL}/output.txt",
        f"results/{MODEL}/prep_{JOBNAME}.db",
        f"results/{MODEL}/{JOBNAME}.txt",

rule run_ansys:
    input:
        "common/input.mac",
        "common/parameters.txt",
        "common/parameters_material.txt",
        "common/prep.mac",
        "common/material.mac",
        "common/solution.mac",
        "common/post.mac",
        f"{MODEL}/parameters_material.txt",
        f"{MODEL}/element.mac",
        f"{MODEL}/concrete_model.mac",
    params:
        model=MODEL,
    output:
        f"results/{MODEL}/output.txt",
        f"results/{MODEL}/prep_{JOBNAME}.db",
        f"results/{MODEL}/{JOBNAME}.txt",
    run:
        RESULTS_DIR.mkdir(parents=True, exist_ok=True)  # ANSYS does not create the directory itself
        (ANSYS_MODELS_DIR / "common" / "model_select.mac").write_text(
            f"! Auto-generated by Snakemake (config['model']={params.model!r}). Do not edit by hand.\n"
            f"MAT_MODEL = '{params.model}'\n"
        )
        argv = [
            ANSYS_EXE,
            "-b",
            "-np", "1",
            "-j", JOBNAME,
            "-dir", str(RESULTS_DIR),
            "-i", str(ANSYS_MODELS_DIR / "common" / "input.mac"),
            "-o", f"{JOBNAME}.out",
        ]
        result = subprocess.run(argv, cwd=RESULTS_DIR) #check=True temporarily removed to allow for non-zero exit codes (WARNINGS) to be ignored.

        out_path = RESULTS_DIR / "output.txt"
        if not out_path.exists():
            raise RuntimeError(
                f"ANSYS did not produce output.txt (exit code {result.returncode}), "
                f"see {RESULTS_DIR / f'{JOBNAME}.out'}"
            )

        log_text = out_path.read_text(errors="replace")
        if "*** ERROR ***" in log_text or "*** FATAL ***" in log_text:
            raise RuntimeError(
                f"ANSYS reported an error in output.txt, see {out_path}"
            )

        results_path = RESULTS_DIR / f"{JOBNAME}.txt"
        if not results_path.exists():
            raise RuntimeError(
                f"ANSYS did not produce {results_path.name} (post-processing results), "
                f"see {RESULTS_DIR / f'{JOBNAME}.out'}"
            )
