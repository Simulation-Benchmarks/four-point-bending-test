! ******************** Materialmodell *********************

! ************************ Beton **************************
! DP strength parameters									
	R_c			= f_c					! Uniaxial compressive strength
	R_t			= 0.1*R_c				! Uniaxial tensile strength (recommended by dynardo (multiplas): R_t=0.1*R_c for normal concrete)
	R_b			= 1.2*R_c				! Biaxial compressive strength (recommended by dynardo (multiplas): R_b=1.2*R_c for normal concrete)
! DILA dilatation
	del_t		= 0.25				 	! Tensile dilatancy parameter / Dilatanzparameter Zug (recommended by dynardo (multiplas): del_t=0.25)
	del_c		= 1.0					! Compression dilatancy parameter / Dilatanzparameter Druck (recommended by dynardo (multiplas): del_c=1.0)
! Fuer beide Entfestigungsgesetze
	omega_ci	= 0.33					! Relative stress at onset (=start) of nonlinear hardening (recommended by dynardo (multiplas): O_ci=0.33)
	omega_cr	= 0.2					! Residual compressive relative stress (recommended by dynardo (multiplas): omega_cr=0.2)
	omega_tr	= 0.1					! Residual tensile relative stress	
	kappa_cm	= 0.0021-R_c/eBeton		! Plastic strain at uniaxial compressive strength (kappa_cm = eps_ml-R_c/E)
! Fuer HSD6 lineare Entfestigung
	kappa_cr	= 0.01					! Ultimate effective plastic strain in compression	
				! 0.005					! -> Wert, an dem man rumschrauben kann / muss (wenn sehr klein gewaehlt, entspricht schnellem Ausschalten des Betons)
	kappa_tr	= 0.001					! Plastic strain limit in tension
! zusaetzlich fuer HSD2 exponentielle Entfestigung
	omega_cu	= 0.85						! Residual relative stress at kappa_cu	
	kappa_cu	= 0.0035-omega_cu*R_c/eBeton! Plastic strain at transition from power law to exponential softening	(kappa_cu = eps_u-omega_u* R_c/E)
	G_ft		= 100						! Mode I area-specific fracture energy [Force/length^2]		

! Lineares Materialverhalten Beton
MP,EX,1,eBeton			
MP,PRXY,1,querdehnzahl_b	

! Nichtlineares Materialverhalten Beton
MAT,1
TB,CONCR,1,,,DP								! Drucker-Prager concrete strength parameters			
TBDATA,1,R_c,R_t,R_b

*IF,schalter_entfest,eq,1,then	
	TB,CONCR,1,,,DILA						! Drucker-Prager concrete dilatation	
	TBDATA,1,del_t,del_c

! Verfestigungsgesetz
	*IF,schalter_dp,eq,0,then
		TB,CONCR,1,,,HSD2
		TBDATA,1,kappa_cm,kappa_cu,omega_ci,omega_cu,omega_cr,G_ft
		TBDATA,7,omega_tr
	*ELSEIF,schalter_dp,eq,1,then
		TB,CONCR,1,,,HSD6
		TBDATA,1,kappa_cm,kappa_cr,omega_ci,omega_cr,kappa_tr,omega_tr
	*ENDIF		
*ENDIF		

! ************************ Stahl **************************	
! Druckbewehrung							
! Lineares Materialverhalten Stahl
MP,EX,2,eStahl		
MP,PRXY,2,querdehnzahl_s

! Nichtlineares Materialverhalten Stahl
MAT,2
TB,MISO,2,1,3
TBPT,DEFI,e_dy1,f_dy1
TBPT,DEFI,e_dy2,f_dy2
TBPT,DEFI,e_du,f_du
	!/axlab,X,Dehnung (/)				! Darstellung der nichtlinearen Spannungs-Dehnungs-Beziehung
	!/axlab,Y,Spannung (N/m^2)
	!TBPLOT,MISO,2

! Zugbewehrung	
! Lineares Materialverhalten Stahl
MP,EX,3,eStahl		
MP,PRXY,3,querdehnzahl_s

! Nichtlineares Materialverhalten Stahl
MAT,3
TB,MISO,3,1,3
TBPT,DEFI,e_zy1,f_zy1
TBPT,DEFI,e_zy2,f_zy2
TBPT,DEFI,e_zu,f_zu
	!/axlab,X,Dehnung (/)
	!/axlab,Y,Spannung (N/m^2)
	!TBPLOT,MISO,3
